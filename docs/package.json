{
  "name": "@zntr/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "bun run mdx && next build",
    "dev": "next dev --port 3002",
    "start": "next start --port 3002",
    "mdx": "fumadocs-mdx",
    "test:mdx": "bun run mdx && node --test ../tests/docs/mdx.test.mjs",
    "type-check": "bun run mdx && next typegen && bun check",
    "lint": "oxlint --fix --config ../config/oxlint.json app components lib mdx-components.tsx source.config.ts next.config.mjs postcss.config.mjs",
    "lint:check": "oxlint --config ../config/oxlint.json app components lib mdx-components.tsx source.config.ts next.config.mjs postcss.config.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.10.5",
    "lucide-react": "1.48.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "25.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
