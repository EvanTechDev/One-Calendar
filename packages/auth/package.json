{
  "name": "@zntr/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts",
    "./adapter": "./src/adapter.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build": "tsc",
    "build:check": "tsc && tsc --noEmit",
