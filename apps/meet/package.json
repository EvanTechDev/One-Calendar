{
  "name": "zentra-meet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --bun next dev -p 3001",
    "build": "bun run --bun next build",
    "build:check": "bun run build && bun run type-check",
    "start": "bun run --bun next start -p 3001",
    "lint": "oxlint --fix --config ../../config/oxlint.json app components hooks lib",
    "lint:check": "oxlint --config ../../config/oxlint.json app components hooks lib",
    "type-check": "bun check",
    "test": "bun test --isolate ../../tests/meet/",
    "test:watch": "bun test --isolate --watch ../../tests/meet/"
  },
  "dependencies": {
    "@livekit/components-react": "2.9.24",
    "@livekit/krisp-noise-filter": "0.4.5",
    "@livekit/track-processors": "^0.8.2",
    "@vercel/functions": "^3.9.11",
    "@zntr/auth": "workspace:*",
    "@zntr/i18n": "workspace:*",
    "@zntr/meetings": "workspace:*",
    "@zntr/ui": "workspace:*",
    "@zntr/utils": "workspace:*",
    "bcryptjs": "latest",
    "botid": "1.5.11",
    "drizzle-orm": "^0.45.2",
    "geist": "latest",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "1.21.0",
    "next": "16.4.3",
    "next-themes": "latest",
    "pg": "^8.23.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.23.1",
    "jsdom": "^29.1.1"
  }
}
