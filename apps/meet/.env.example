# LiveKit — required
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# e.g. wss://my-project.livekit.cloud
LIVEKIT_URL=

# Better Auth (shared with zentra-calendar)
# BETTER_AUTH_SECRET must be BYTE-IDENTICAL to the calendar's. The session
# cookie is signed with it, so a mismatch presents as "signed in on the
# calendar, anonymous here" with no error logged anywhere — the dashboard is
# unreachable and an organiser is not recognised as their own meeting's
# Organiser (no "End meeting for all").
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Share the session cookie with the calendar. Optional; unset means host-only
# cookies, which is correct for local development (two ports on localhost
# already share a cookie jar). Must be the SAME value as the calendar's.
#
# Requires BOTH apps to be subdomains of this domain (e.g. cal.zntr.app +
# meet.zntr.app with `.zntr.app`). A cookie's Domain may only be a parent of
# the host that set it, so two different REGISTERED domains can never share a
# session this way — that needs a token hand-off instead.
# AUTH_COOKIE_DOMAIN=.zntr.app

# Postgres (same database as zentra-calendar)
POSTGRES_URL=

# Field-encryption key material, read-only here. The calendar encrypts event
# titles at rest keyed by (SALT, row id); the dashboard decrypts them to label
# meetings. Must be BYTE-IDENTICAL to the calendar's SALT — a wrong or missing
# value makes every calendar-linked meeting read "Untitled meeting". A warning
# is logged once when it is missing so this is not silent.
SALT=

# The calendar app's origin. Used for the "Sign in" link (meet has no sign-in
# surface of its own) and returned to afterwards.
NEXT_PUBLIC_CALENDAR_ORIGIN=http://localhost:3000

# Optional — rate limiting (fails open when unset)
REDIS_URL=

# Required for the expired-meeting cleanup cron
CRON_SECRET=

# Optional — recording (S3 egress destination)
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=

# LiveKit webhooks (attendance and duration). Configure the LiveKit project
# to POST to <origin>/api/webhooks/livekit — it signs with the API key pair
# above, so no extra secret is needed.
