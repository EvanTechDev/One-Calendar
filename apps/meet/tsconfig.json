{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@zntr/ui": ["../../packages/ui/src/index.ts"],
      "@zntr/ui/*": ["../../packages/ui/src/*"],
      "@zntr/utils": ["../../packages/utils/src/index.ts"],
      "@zntr/utils/*": ["../../packages/utils/src/*"],
      "@zntr/auth": ["../../packages/auth/src/index.ts"],
      "@zntr/meetings": ["../../packages/meetings/src/index.ts"],
      "@zntr/meetings/*": ["../../packages/meetings/src/*"],
      "@zntr/auth/*": ["../../packages/auth/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
