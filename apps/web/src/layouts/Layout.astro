---
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "imput",
  description = "We develop private, efficient, and respectful software.",
} = Astro.props
---

<!doctype html>
<html lang="en" class="bg-background h-dvh overflow-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-foreground font-sans h-dvh overflow-hidden">
    <slot />
  </body>
</html>
