{
  "name": "zentra-calendar",
  "version": "3.0.0-rc.45",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "pnpm generate:i18n && pnpm mdx && bun run --bun next build",
    "build:check": "pnpm build && pnpm type-check",
    "start": "bun run --bun next start",
    "generate:i18n": "pnpm --filter @zntr/i18n generate",
    "cleanup:i18n": "pnpm --filter @zntr/i18n cleanup",
    "mdx": "fumadocs-mdx",
    "lint": "oxlint --fix --config ../../config/oxlint.json app components hooks lib proxy.ts",
    "lint:check": "oxlint --config ../../config/oxlint.json app components hooks lib proxy.ts",
    "type-check": "pnpm mdx && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/groq": "4.0.54",
    "@ai-sdk/react": "4.0.130",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@types/mdx": "^2.0.13",
    "@vercel/functions": "^3.9.11",
    "@zntr/agent": "workspace:*",
    "@zntr/auth": "workspace:*",
    "@zntr/i18n": "workspace:*",
    "@zntr/meetings": "workspace:*",
    "@zntr/ui": "workspace:*",
    "@zntr/utils": "workspace:*",
    "ai": "7.0.127",
    "bcryptjs": "latest",
    "botid": "1.5.11",
    "date-fns": "4.4.0",
    "drizzle-orm": "^0.45.2",
    "evlog": "2.19.2",
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.10.5",
    "geist": "latest",
    "ioredis": "^5.11.1",
    "lucide-react": "1.48.0",
    "motion": "^12.41.0",
    "next": "16.3.8",
    "next-themes": "latest",
    "pg": "^8.23.1",
    "postcss": "8.5.28",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.6.0",
    "react-remove-scroll": "2.7.2",
    "resend": "6.14.0",
    "rrule": "2.8.1",
    "shadcn": "4.21.1",
    "sonner": "2.0.8",
    "streamdown": "2.7.0",
    "swr": "^2.5.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.23.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
