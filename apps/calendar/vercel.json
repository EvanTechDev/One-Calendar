{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "functions": {
    "app/api/agent/chat/route.ts": { "supportsCancellation": true }
  },
  "crons": [
    {
      "path": "/api/blob/check",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/reminders/topup",
      "schedule": "0 2 * * *"
    }
  ]
}
