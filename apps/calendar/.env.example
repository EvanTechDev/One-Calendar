# Core
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Field-encryption key material for event titles/descriptions/locations.
# Minimum 16 characters; use a long random string in production.
# WARNING: changing SALT makes every existing encrypted row undecryptable.
# There is no rotation path yet — rows are keyed by (SALT, row id) with no
# second-key fallback, so a change requires re-encrypting existing data.
SALT=Backup-Salt-Placeholder

# Auth
# BETTER_AUTH_SECRET must be BYTE-IDENTICAL to Zentra Meet's. The session
# cookie is signed with it, so a mismatch presents as "signed in on the
# calendar, anonymous on meet" with no error logged anywhere.
BETTER_AUTH_SECRET=secret
BETTER_AUTH_URL=http://localhost:3000

# Share the session cookie with Zentra Meet. Optional; unset means each app
# keeps host-only cookies, which is correct for local development (two ports on
# localhost already share a cookie jar).
#
# Requirements, neither of which this variable can work around:
#  1. BOTH apps must be served from the SAME registered domain, as subdomains
#     of the value below (e.g. cal.zntr.app + meet.zntr.app with `.zntr.app`).
#     A cookie's Domain may only be a parent of the host that set it, so two
#     different registered domains (zentra-cal.com + zentra-meet.com) can
#     NEVER share a session this way — that needs a token hand-off instead.
#  2. BETTER_AUTH_SECRET must match exactly, as above.
#
# Set the SAME value in apps/meet.
# AUTH_COOKIE_DOMAIN=.zntr.app

# Optional
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/onecalendar
# Default: require (encrypted connection without peer verification).
# Set verify-full to validate the certificate chain and hostname. For providers
# with a private root, also set its PEM certificate below. Literal newlines or
# escaped `\n` are accepted.
# DATABASE_SSL=verify-full
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Local development only: disable turns TLS off.
# DATABASE_SSL=disable
REDIS_URL=rediss://default:password@your-region.upstash.io:6379
BETTER_AUTH_API_KEY=your-api-key
# Turnstile CAPTCHA on sign-in and sign-up. Set BOTH or NEITHER.
# Unset means no CAPTCHA — sign-in still works (see ADR-0011), and the server
# logs a warning on every attempt so a lost variable is visible.
# Setting only the secret leaves the widget unrendered but verification enabled,
# which is the one combination that will refuse every login.
# NEXT_PUBLIC_* is inlined at BUILD time, so on Vercel it must be scoped to every
# environment you deploy (Production AND Preview), not just Production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=site-key
TURNSTILE_SECRET_KEY=secret-key

# MCP allowed cross-origins (comma-separated). Empty = same-origin only.
MCP_ALLOWED_ORIGINS=
# Vercel cron auth; Vercel sends it as Authorization: Bearer automatically.
# Unset means every cron route returns 401 (fail closed), so the reminder
# top-up will never run and email reminders stop after their first 30 days.
CRON_SECRET=

# Email delivery (Resend). Required for invitation emails and for the opt-in
# per-event email reminders. Unset means neither is sent; the app still works.
# Free tier is 3,000/month and 100/day, shared between both.
RESEND_API_KEY=
# Zentra Meet origin. Used to compose meeting links on events, and as the ONLY
# allowlisted destination for /sign-in?redirect= — meet links here to
# authenticate and expects the user back, and without an allowlist that would
# be an open redirect off a fresh session.
NEXT_PUBLIC_MEET_ORIGIN=http://localhost:3001
