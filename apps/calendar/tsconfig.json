{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "collections/*": ["./.source/*"],
      "@zntr/agent": ["../../packages/agent/src/index.ts"],
      "@zntr/agent/*": ["../../packages/agent/src/*"],
      "@zntr/ui": ["../../packages/ui/src/index.ts"],
      "@zntr/ui/*": ["../../packages/ui/src/*"],
      "@zntr/utils": ["../../packages/utils/src/index.ts"],
      "@zntr/utils/*": ["../../packages/utils/src/*"],
      "@zntr/i18n": ["../../packages/i18n/src/index.ts"],
      "@zntr/i18n/*": ["../../packages/i18n/src/*"],
      "@zntr/auth": ["../../packages/auth/src/index.ts"],
      "@zntr/auth/*": ["../../packages/auth/src/*"],
      "@zntr/shared/calendar": ["../../packages/shared/calendar/index.tsx"],
      "@zntr/shared/calendar/*": ["../../packages/shared/calendar/*"],
      "@zntr/shared/meetings": ["../../packages/shared/meetings/index.ts"],
      "@zntr/shared/meetings/*": ["../../packages/shared/meetings/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
