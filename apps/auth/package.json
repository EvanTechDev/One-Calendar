{
  "name": "zentra-auth",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "build:check": "pnpm build && pnpm type-check",
    "start": "next start -p 3002",
    "lint": "oxlint --fix --config ../../config/oxlint.json app components lib",
    "lint:check": "oxlint --config ../../config/oxlint.json app components lib",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.1",
    "@marsidev/react-turnstile": "1.5.3",
    "@zntr/auth": "workspace:*",
    "@zntr/ui": "workspace:*",
    "@zntr/utils": "workspace:*",
    "bcryptjs": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "geist": "latest",
    "lucide-react": "1.21.0",
    "next": "16.3.0",
    "next-themes": "latest",
    "postgres": "^3.4.9",
    "radix-ui": "latest",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
