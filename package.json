{
  "name": "zntr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build:calendar": "pnpm --filter zentra-calendar build",
    "dev:meet": "pnpm --filter zentra-meet dev",
    "build:meet": "pnpm --filter zentra-meet build",
    "lint:meet": "pnpm --filter zentra-meet lint",
    "tc:meet": "pnpm --filter zentra-meet type-check",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "tc:web": "pnpm --filter web type-check",
    "prepare": "husky",
    "lint:calendar": "pnpm --filter zentra-calendar lint",
    "tc:calendar": "pnpm --filter zentra-calendar type-check",
    "lint:auth": "pnpm --filter @zntr/auth lint",
    "tc:auth": "pnpm --filter @zntr/auth type-check",
    "test:calendar": "pnpm --filter zentra-calendar test",
    "test:calendar:watch": "pnpm --filter zentra-calendar test:watch",
    "generate:i18n": "pnpm --filter @zntr/i18n generate",
    "cleanup:i18n": "pnpm --filter @zntr/i18n cleanup",
    "format": "prettier . --write --ignore-path config/.prettierignore",
    "format:check": "prettier . --check --ignore-path config/.prettierignore"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@commitlint/types": "20.5.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/rrule": "^2.2.9",
    "drizzle-kit": "latest",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "next": "16.3.0",
    "oxlint": "1.71.0",
    "postcss": "8.5.15",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 2,
    "arrowParens": "always"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "oxlint --fix --config config/oxlint.json"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "test",
          "chore",
          "revert"
        ]
      ],
      "subject-max-length": [
        2,
        "always",
        100
      ]
    }
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "ignoreFiles": [
      "apps/calendar/public/sw.js"
    ],
    "ignoreIssues": {
      "apps/calendar/components/providers/calendar-context.tsx": [
        "exports",
        "duplicates"
      ],
      "packages/ui/src/**": [
        "exports"
      ],
      "apps/calendar/lib/evlog.ts": [
        "exports"
      ]
    }
  },
  "dependencies": {
    "rrule": "^2.8.1"
  }
}
